{
  "name": "lumacut",
  "productName": "Lumacut",
  "desktopName": "lumacut.desktop",
  "version": "1.0.0",
  "description": "Free desktop video editor with optional AI editing",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Hosea Felix Sanjaya",
    "email": "felix190606@gmail.com"
  },
  "homepage": "https://github.com/Pascalllllll/Lumacut-video-editor-",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "test:render": "electron-vite build && playwright test --config playwright.render.config.ts",
    "fetch:binaries": "node scripts/fetch-binaries.mjs",
    "fetch:models": "node scripts/fetch-models.mjs",
    "dist:linux": "node scripts/dist.mjs linux",
    "dist:flatpak": "node scripts/dist.mjs linux flatpak --x64",
    "dist:win": "node scripts/dist.mjs win",
    "dist:mac": "node scripts/dist.mjs mac",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@huggingface/transformers": "4.3.1",
    "electron-updater": "6.8.10",
    "fflate": "0.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.13.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "immer": "11.2.9",
    "lucide-react": "1.61.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  }
}
