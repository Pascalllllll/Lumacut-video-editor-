{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@engine/*": ["./src/engine/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": [
    "./src/renderer/src/**/*",
    "./src/renderer/src/**/*.json",
    "./src/preload/api.d.ts",
    "./src/shared/**/*",
    "./src/engine/**/*",
    "./src/render/**/*",
    "./src/audio/**/*",
    "./src/ai/**/*"
  ]
}
